;———————————————————————————————————————————————————————————————
; PROCEDURE NodeChanged (theGlobals: Ptr);
;———————————————————————————————————————————————————————————————
NODECHANGED     PROC    ENTRY

StackFrame      RECORD  {A6Link},DECR
theGlobals      DS.L    1
RetAddr         DS.L    1
A6Link          DS.L    1
theCell         DS      Point
LocalSize       EQU     *
                ENDR

                WITH    Globals,StackFrame

                LINK    A6,#LocalSize
                MOVE.L  A4,-(SP)

                MOVE.L  (theGlobals,A6),A4

                SUBQ.L  #2,SP
                PEA     (theCell,A6)
                MOVE.L  (nodeList,A4),-(SP)
                BSR     GetSelect
                TST.B   (SP)+
                BNE.S   @0
                MOVE    #255,D0
                BRA.S   @1
@0              MOVEQ   #0,D0

@1              MOVE.L  (myDialog,A4),-(SP)
                MOVE    D0,-(SP)
