;———————————————————————————————————————————————————————————————
; PROCEDURE OutlineItem (theDialog: DialogPtr; itemNo: INTEGER);
;———————————————————————————————————————————————————————————————
OUTLINEITEM     PROC    ENTRY

StackFrame      RECORD  {A6Link},DECR
ParamBegin      EQU     *
theDialog       DS.L    1
itemNo          DS.W    1
ParamSize       EQU     ParamBegin-*
RetAddr         DS.L    1
A6Link          DS.L    1
box             DS      Rect
pnState         DS      PenState
LocalSize       EQU     *
                ENDR

                WITH    Globals,StackFrame

                LINK    A6,#LocalSize
                MOVEM.L A3/A4,-(SP)

                MOVE.L  (theDialog,A6),A3

                SUBQ.L  #4,SP
                MOVE.L  A3,-(SP)
                _GetWRefCon
                MOVE.L  (SP)+,A4

                MOVE.L  A3,-(SP)
                MOVE    #ok,-(SP)
                PEA     (box,A6)
                BSR     GetIBox

                PEA     (pnState,A6)
                _GetPenState
                _PenNormal

                MOVEQ   #3,D0
                MOVE    D0,-(SP)
                MOVE    D0,-(SP)
                _PenSize

                PEA     (box,A6)
                MOVEQ   #-4,D0
                MOVE    D0,-(SP)
                MOVE    D0,-(SP)
                _InsetRect

                CMP.B   #255,(outlineState,A4)
                BNE.S   @0

                MOVE.L  (0,A5),A0
                PEA     (CurrentQDGlobals.gray,A0)
                _PenPat

@0              PEA     (box,A6)
                MOVEQ   #16,D0
                MOVE    D0,-(SP)
                MOVE    D0,-(SP)
                _FrameRoundRect

                PEA     (pnState,A6)
                _SetPenState

Exit            MOVEM.L (SP)+,A3/A4
                UNLK    A6
                MOVE.L  (SP)+,A0
                ADDQ.L  #ParamSize,SP
                JMP     (A0)

                ENDP
;———————————————————————————————————————————————————————————————
; PROCEDURE TextItem (theDialog: DialogPtr; itemNo: INTEGER);
;———————————————————————————————————————————————————————————————
TEXTITEM        PROC    ENTRY

                IMPORT  GETINDSTRING

StackFrame      RECORD  {A6Link},DECR
ParamBegin      EQU     *
theDialog       DS.L    1
itemNo          DS.W    1
ParamSize       EQU     ParamBegin-*
RetAddr         DS.L    1
A6Link          DS.L    1
box             DS      Rect
theString       DS.B    256
LocalSize       EQU     *
                ENDR

                WITH    StackFrame

                LINK    A6,#LocalSize
                MOVEM.L D7/A3/A4,-(SP)

                MOVE    (itemNo,A6),D7
                LEA     (box,A6),A4

                MOVE.L  (theDialog,A6),-(SP)
                MOVE    D7,-(SP)
                MOVE.L  A4,-(SP)
                BSR     GetIBox

                SUBQ    #2,D7
                LEA     (theString,A6),A3

                MOVE.L  A3,-(SP)
                MOVE    #5000,-(SP)
                MOVE    D7,-(SP)
                JSR     GetIndString

                MOVEQ   #0,D0
                MOVE.B  (A3)+,D0

                MOVE.L  A3,-(SP)
                MOVE.L  D0,-(SP)
                MOVE.L  A4,-(SP)
                MOVE    #teJustCenter,-(SP)
                _TETextBox

Exit            MOVEM.L (SP)+,D7/A3/A4
                UNLK    A6
                MOVE.L  (SP)+,A0
                ADDQ.L  #ParamSize,SP
                JMP     (A0)

                ENDP
;———————————————————————————————————————————————————————————————
; PROCEDURE ListItem (theDialog: DialogPtr; itemNo: INTEGER);
;———————————————————————————————————————————————————————————————
LISTITEM        PROC    ENTRY

StackFrame      RECORD  {A6Link},DECR
ParamBegin      EQU     *
theDialog       DS.L    1
itemNo          DS.W    1
ParamSize       EQU     ParamBegin-*
RetAddr         DS.L    1
A6Link          DS.L    1
box             DS      Rect
pnState         DS      PenState
LocalSize       EQU     *
                ENDR

                WITH    Globals,StackFrame

                LINK    A6,#LocalSize
                MOVEM.L D7/A3/A4,-(SP)

                MOVE.L  (theDialog,A6),A3

                SUBQ.L  #4,SP
                MOVE.L  A3,-(SP)
                _GetWRefCon
                MOVE.L  (SP)+,A4

                MOVE    (itemNo,A6),D7

                MOVE.L  A3,-(SP)
                MOVE    D7,-(SP)
                PEA     (box,A6)
                BSR     GetIBox

                PEA     (pnState,A6)
                _GetPenState
                _PenNormal

                PEA     (box,A6)
                _FrameRect

                MOVEQ   #2,D0
                MOVE    D0,-(SP)
                MOVE    D0,-(SP)
                _PenSize

                PEA     (box,A6)
                MOVEQ   #-3,D0
                MOVE    D0,-(SP)
                MOVE    D0,-(SP)
                _InsetRect

                CMP     (selectedList,A4),D7
                BEQ.S   @0

                MOVE    #notPatCopy,-(SP)
                _PenMode

@0              PEA     (box,A6)
                _FrameRect

                SUBQ    #6,D7
                ASL     #2,D7

                MOVE.L  (GrafPort.visRgn,A3),-(SP)
                MOVE.L  (zoneList,A4,D7),-(SP)
                _LUpdate

                PEA     (pnState,A6)
                _SetPenState

Exit            MOVEM.L (SP)+,D7/A3/A4
                UNLK    A6
                MOVE.L  (SP)+,A0
                ADDQ.L  #ParamSize,SP
                JMP     (A0)

                ENDP
;———————————————————————————————————————————————————————————————
; PROCEDURE FlashButton (theDialog: DialogPtr; itemNo: INTEGER);
;———————————————————————————————————————————————————————————————
FLASHBUTTON     PROC    ENTRY

StackFrame      RECORD  {A6Link},DECR
ParamBegin      EQU     *
theDialog       DS.L    1
itemNo          DS.W    1
ParamSize       EQU     ParamBegin-*
RetAddr         DS.L    1
A6Link          DS.L    1
itemType        DS.W    1
item            DS.L    1
box             DS      Rect
LocalSize       EQU     *
                ENDR

                WITH    StackFrame

                LINK    A6,#LocalSize

                MOVE.L  (theDialog,A6),-(SP)
                MOVE    (itemNo,A6),-(SP)
                PEA     (itemType,A6)
                PEA     (item,A6)
                PEA     (box,A6)
                _GetDialogItem

                MOVE.L  (item,A6),-(SP)
                MOVE    #inButton,-(SP)
                _HiliteControl

                MOVE    #8,A0
                _Delay

                MOVE.L  (item,A6),-(SP)
                MOVE    #0,-(SP)
                _HiliteControl

Exit            UNLK    A6
                MOVE.L  (SP)+,A0
                ADDQ.L  #ParamSize,SP
                JMP     (A0)

                ENDP
;———————————————————————————————————————————————————————————————
; FUNCTION ButtonKey (theEvent: EventRecord; theGlobals: Ptr) : INTEGER;
;———————————————————————————————————————————————————————————————
BUTTONKEY       FUNC    ENTRY

StackFrame      RECORD  {A6Link},DECR
Result          DS.W    1
ParamBegin      EQU     *
theEvent        DS.L    1
theGlobals      DS.L    1
ParamSize       EQU     ParamBegin-*
RetAddr         DS.L    1
A6Link          DS.L    1
LocalSize       EQU     *
                ENDR

                WITH    Globals,StackFrame

                LINK    A6,#LocalSize
                MOVEM.L A3/A4,-(SP)

                CLR     (Result,A6)
                MOVE.L  (theGlobals,A6),A4
                MOVE.L  (theEvent,A6),A3

                MOVE    (EventRecord.what,A3),D0
                CMP     #keyDown,D0
                BNE.S   Exit
                MOVE.L  (EventRecord.message,A3),D0

                CMP.B   #CR,D0
                BEQ.S   @0
                CMP.B   #ETX,D0
                BNE.S   @1
@0              TST.B   (outlineState,A4)
                BNE.S   Exit
                MOVE.L  (myDialog,A4),-(SP)
                MOVE    #ok,-(SP)
                BSR     FlashButton
                MOVE    #ok,(Result,A6)
                BRA.S   Exit

@1              CMP     #$351B,D0               ; ESC
                BEQ.S   @2
                CMP.B   #'.',D0
                BNE.S   Exit
                BTST    #cmdKeyBit-8,(EventRecord.modifiers,A3)
                BEQ.S   Exit
@2              MOVE.L  (myDialog,A4),-(SP)
                MOVE    #cancel,-(SP)
                BSR     FlashButton
                MOVE    #cancel,(Result,A6)

Exit            MOVEM.L (SP)+,A3/A4
                UNLK    A6
                MOVE.L  (SP)+,A0
                ADDQ.L  #ParamSize,SP
                JMP     (A0)

                ENDF
;———————————————————————————————————————————————————————————————
; PROCEDURE ListArrow (charCode: Byte; lHandle: ListHandle);
;———————————————————————————————————————————————————————————————
LISTARROW       PROC    ENTRY

StackFrame      RECORD  {A6Link},DECR
ParamBegin      EQU     *
charCode        DS.W    1
lHandle         DS.L    1
ParamSize       EQU     ParamBegin-*
RetAddr         DS.L    1
A6Link          DS.L    1
theCell         DS      Point
LocalSize       EQU     *
                ENDR

                WITH    StackFrame

                LINK    A6,#LocalSize
                MOVEM.L D5-D7/A4,-(SP)

                MOVE.L  (lHandle,A6),A4
                MOVE.B  (charCode,A6),D7

                MOVE.L  (A4),A0
                MOVE    (ListRec.dataBounds+Rect.top,A0),D6
                MOVE    (ListRec.dataBounds+Rect.bottom,A0),D5
                SUBQ    #1,D5

                SUBQ.L  #2,SP
                PEA     (theCell,A6)
                MOVE.L  A4,-(SP)
                BSR     GetSelect
                TST.B   (SP)+
                BNE.S   @1

                MOVE.L  (A4),A0
                MOVE    (ListRec.dataBounds+Rect.left,A0),(theCell.h,A6)

                CMP.B   #US,D7
                BNE.S   @0
                MOVE    D6,(theCell.v,A6)
                BRA.S   @6
@0              CMP.B   #RS,D7
                BNE.S   Exit
                MOVE    D5,(theCell.v,A6)
                BRA.S   @6

@1              CMP     (theCell.v,A6),D6
                BNE.S   @2
                CMP.B   #RS,D7
                BEQ.S   Exit
@2              CMP     (theCell.v,A6),D5
                BNE.S   @3
                CMP.B   #US,D7
                BEQ.S   Exit

@3              SF      -(SP)
                MOVE.L  (theCell,A6),-(SP)
                MOVE.L  A4,-(SP)
                _LSetSelect

                CMP.B   #RS,D7
                BNE.S   @4
                MOVEQ   #-1,D0
                BRA.S   @5
@4              CMP.B   #US,D7
                BNE.S   Exit
                MOVEQ   #+1,D0

@5              ADD     D0,(theCell.v,A6)

@6              MOVE.L  (theCell,A6),-(SP)
                MOVE.L  A4,-(SP)
                BSR     SetSelectSeq

Exit            MOVEM.L (SP)+,D5-D7/A4
                UNLK    A6
                MOVE.L  (SP)+,A0
                ADDQ.L  #ParamSize,SP
                JMP     (A0)

                ENDP
;———————————————————————————————————————————————————————————————
; PROCEDURE ListKeyNav (pKN: KNRec; lHandle: ListHandle);
;———————————————————————————————————————————————————————————————
LISTKEYNAV      PROC    ENTRY

StackFrame      RECORD  {A6Link},DECR
ParamBegin      EQU     *
pKN             DS.L    1
lHandle         DS.L    1
ParamSize       EQU     ParamBegin-*
RetAddr         DS.L    1
A6Link          DS.L    1
dataLen         DS.W    1
oldCell         DS      Point
newCell         DS      Point
theString       DS.B    34
LocalSize       EQU     *
                ENDR

                WITH    StackFrame

                LINK    A6,#LocalSize
                MOVEM.L D7/A3/A4,-(SP)

                MOVE.L  (lHandle,A6),A4
                LEA     (theString,A6),A3

                MOVE.L  (A4),A0
                MOVE.L  (ListRec.dataBounds+Rect.topLeft,A0),(newCell,A6)
                MOVE    (ListRec.dataBounds+Rect.bottom,A0),D7

@0              MOVE    #32,(dataLen,A6)
                PEA     (1,A3)
                PEA     (dataLen,A6)
                MOVE.L  (newCell,A6),-(SP)
                MOVE.L  A4,-(SP)
                _LGetCell
                MOVE.B  (dataLen+1,A6),(A3)

                SUBQ.L  #2,SP
                MOVE.L  A3,-(SP)
                MOVE.L  (pKN,A6),-(SP)
                BSR     KNCompString
                TST     (SP)+
                BLE.S   @1

                ADDQ    #1,(newCell.v,A6)

                CMP     (newCell.v,A6),D7
                BGT.S   @0

                SUBQ    #1,(newCell.v,A6)

@1              SUBQ.L  #2,SP
                PEA     (oldCell,A6)
                MOVE.L  A4,-(SP)
                BSR     GetSelect
                TST.B   (SP)+
                BEQ.S   @2

                MOVE.L  (newCell,A6),D0
                CMP.L   (oldCell,A6),D0
                BEQ.S   Exit

                SF      -(SP)
                MOVE.L  (oldCell,A6),-(SP)
                MOVE.L  A4,-(SP)
                _LSetSelect

@2              MOVE.L  (newCell,A6),-(SP)
                MOVE.L  A4,-(SP)
                BSR     SetSelect

Exit            MOVEM.L (SP)+,D7/A3/A4
                UNLK    A6
                MOVE.L  (SP)+,A0
                ADDQ.L  #ParamSize,SP
                JMP     (A0)

                ENDP
;———————————————————————————————————————————————————————————————
; PROCEDURE ListKey (theEvent: EventRecord; theGlobals: Ptr);
;———————————————————————————————————————————————————————————————
LISTKEY         PROC    ENTRY

StackFrame      RECORD  {A6Link},DECR
ParamBegin      EQU     *
theEvent        DS.L    1
theGlobals      DS.L    1
ParamSize       EQU     ParamBegin-*
RetAddr         DS.L    1
A6Link          DS.L    1
LocalSize       EQU     *
                ENDR

                WITH    Globals,StackFrame

                LINK    A6,#LocalSize
                MOVEM.L D7/A2-A4,-(SP)

                MOVE.L  (theGlobals,A6),A4
                MOVE.L  (theEvent,A6),A3
                MOVE.L  (EventRecord.message,A3),D7

                CMP.B   #HT,D7
                BNE.S   @2
                PEA     (keyNav,A4)
                BSR     KNInit
                MOVE    (selectedList,A4),D0
                BTST    #shiftKeyBit-8,(EventRecord.modifiers,A3)
                BEQ.S   @0
                SUBQ    #1,D0
                CMP     #6,D0
                BGE.S   @1
                MOVEQ   #7,D0
                BRA.S   @1
@0              ADDQ    #1,D0
                CMP     #7,D0
                BLE.S   @1
                MOVEQ   #6,D0
@1              MOVE.L  (myDialog,A4),-(SP)
                MOVE    D0,-(SP)
                BSR     SelectList
                BRA.S   Exit

@2              MOVE    (selectedList,A4),D0
                SUBQ    #6,D0
                ASL     #2,D0
                MOVE.L  (zoneList,A4,D0),A2
                MOVE.L  (A2),A0
                MOVE    (ListRec.dataBounds+Rect.top,A0),D0
                CMP     (ListRec.dataBounds+Rect.bottom,A0),D0
                BEQ.S   Exit
                SF      (autoSelect,A4)
                CMP.B   #RS,D7
                BEQ.S   @3
                CMP.B   #US,D7
                BNE.S   @4
@3              MOVE.B  D7,-(SP)
                MOVE.L  A2,-(SP)
                BSR     ListArrow
                PEA     (keyNav,A4)
                BSR     KNInit
                BRA.S   Exit
@4              SUBQ.L  #2,SP
                MOVE.L  A3,-(SP)
                PEA     (keyNav,A4)
                BSR     KNKey
                TST.B   (SP)+
                BEQ.S   Exit
                PEA     (keyNav,A4)
                MOVE.L  A2,-(SP)
                BSR     ListKeyNav

Exit            MOVEM.L (SP)+,D7/A2-A4
                UNLK    A6
                MOVE.L  (SP)+,A0
                ADDQ.L  #ParamSize,SP
                JMP     (A0)

                ENDP
;———————————————————————————————————————————————————————————————
; FUNCTION MyFilter (theDialog: DialogPtr; VAR theEvent: EventRecord;
;                    VAR itemHit: INTEGER) : BOOLEAN;
;———————————————————————————————————————————————————————————————
MYFILTER        FUNC    ENTRY

                IMPORT  GETBRIDGEADDRESS

StackFrame      RECORD  {A6Link},DECR
Result          DS.W    1
ParamBegin      EQU     *
theDialog       DS.L    1
theEvent        DS.L    1
itemHit         DS.L    1
ParamSize       EQU     ParamBegin-*
RetAddr         DS.L    1
A6Link          DS.L    1
thePt           DS      Point
theCell         DS      Point
LocalSize       EQU     *
                ENDR

                WITH    Globals,StackFrame

                LINK    A6,#LocalSize
                MOVEM.L D3-D7/A2-A4,-(SP)

                CLR     (Result,A6)
                MOVE.L  (theDialog,A6),A3
                SUBQ.L  #4,SP
                MOVE.L  A3,-(SP)
                _GetWRefCon
                MOVE.L  (SP)+,A4

                MOVE.L  (theEvent,A6),A0
                MOVE    (EventRecord.what,A0),D0

@0              CMP     #nullEvent,D0
                BEQ.S   @1
                CMP     #updateEvt,D0
                BNE.S   @10
                CMP.L   (EventRecord.message,A0),A3
                BEQ     Exit

@1              SUBQ.L  #2,SP
                JSR     GetBridgeAddress
                TST     (SP)+
                SNE     D0
                CMP.B   (hasBridge,A4),D0
                BEQ.S   @2
                MOVE.B  D0,(hasBridge,A4)
                MOVE.L  A4,-(SP)
                BSR     NetChanged
@2              TST.L   (lookupPB,A4)
                BEQ     Exit
                MOVE.L  A4,-(SP)
                BSR     NBPRead
                BRA     Exit

@10             CMP     #keyDown,D0
                BEQ.S   @11
                CMP     #autoKey,D0
                BNE     @20

@11             SUBQ.L  #2,SP
                MOVE.L  (theEvent,A6),-(SP)
                MOVE.L  A4,-(SP)
                BSR     ButtonKey
                MOVE    (SP)+,D0
                BEQ.S   @12
                MOVE.L  (itemHit,A6),A0
                MOVE    D0,(A0)
                ST      (Result,A6)
                BRA     Exit

@12             SUBQ.L  #2,SP
                PEA     (theCell,A6)
                MOVE.L  (zoneList,A4),-(SP)
                BSR     GetSelect
                ADDQ.L  #2,SP
                MOVE.L  (theCell,A6),D7
                SUBQ.L  #2,SP
                PEA     (theCell,A6)
                MOVE.L  (nodeList,A4),-(SP)
                BSR     GetSelect
                ADDQ.L  #2,SP
                MOVE.L  (theCell,A6),D6

                MOVE.L  (theEvent,A6),-(SP)
                MOVE.L  A4,-(SP)
                BSR     ListKey

                MOVE    (selectedList,A4),D0
                CMP     #6,D0
                BNE.S   @13
                SUBQ.L  #2,SP
                PEA     (theCell,A6)
                MOVE.L  (zoneList,A4),-(SP)
                BSR     GetSelect
                ADDQ.L  #2,SP
                CMP.L   (theCell,A6),D7
                BEQ     Exit
                MOVE.L  A4,-(SP)
                BSR     ZoneChanged
                BRA     Exit
@13             CMP     #7,D0
                BNE     Exit
                SUBQ.L  #2,SP
                PEA     (theCell,A6)
                MOVE.L  (nodeList,A4),-(SP)
                BSR     GetSelect
                ADDQ.L  #2,SP
                CMP.L   (theCell,A6),D6
                BEQ     Exit
                MOVE.L  A4,-(SP)
                BSR     NodeChanged
                BRA     Exit

@20             CMP     #mouseDown,D0
                BNE     Exit

@21             MOVE.L  (theEvent,A6),A0
                MOVE.L  (EventRecord.where,A0),(thePt,A6)
                PEA     (thePt,A6)
                _GlobalToLocal
                SUBQ.L  #2,SP
                MOVE.L  A3,-(SP)
                MOVE.L  (thePt,A6),-(SP)
                _FindDialogItem
                MOVE    (SP)+,D7
                ADDQ    #1,D7
                CMP     #6,D7
                BLT     Exit
                CMP     #7,D7
                BGT     Exit
                PEA     (keyNav,A4)
                BSR     KNInit
                CMP     (selectedList,A4),D7
                BEQ.S   @22
                MOVE.L  A3,-(SP)
                MOVE    D7,-(SP)
                BSR     SelectList
@22             MOVE    D7,D0
                SUBQ    #6,D0
                ASL     #2,D0
                MOVE.L  (zoneList,A4,D0),A2
                SUBQ.L  #2,SP
                PEA     (theCell,A6)
                MOVE.L  A2,-(SP)
                BSR     GetSelect
                ADDQ.L  #2,SP
                MOVE.L  (theCell,A6),D6

                SUBQ.L  #2,SP
                MOVE.L  (thePt,A6),-(SP)
                MOVE.L  (theEvent,A6),A0
                MOVE    (EventRecord.modifiers,A0),-(SP)
                MOVE.L  A2,-(SP)
                _LClick
                MOVE.B  (SP)+,D5

                SUBQ.L  #2,SP
                PEA     (theCell,A6)
                MOVE.L  A2,-(SP)
                BSR     GetSelect
                MOVE.B  (SP)+,D4
                CMP.L   (theCell,A6),D6
                BEQ.S   @26
                SF      (autoSelect,A4)
                CMP     #6,D7
                BNE.S   @25
                MOVE.L  A4,-(SP)
                BSR     ZoneChanged
                BRA.S   @26
@25             CMP     #7,D7
                BNE.S   @26
                MOVE.L  A4,-(SP)
                BSR     NodeChanged
@26             TST.B   D5
                BEQ.S   Exit
                CMP     #7,D7
                BNE.S   Exit
                TST.B   D4
                BEQ.S   Exit
                MOVE.L  A3,-(SP)
                MOVE    #ok,-(SP)
                BSR     FlashButton
                MOVE.L  (itemHit,A6),A0
                MOVE    #ok,(A0)
                ST      (Result,A6)

Exit            MOVEM.L (SP)+,D3-D7/A2-A4
                UNLK    A6
                MOVE.L  (SP)+,A0
                ADD     #ParamSize,SP
                JMP     (A0)

                ENDF
;———————————————————————————————————————————————————————————————
; FUNCTION IPCBrowser (default: BOOLEAN; VAR theLocation: EntityName;
;                      theLocNBPType: Str32) : OSErr;
;———————————————————————————————————————————————————————————————
IPCBROWSER      FUNC    EXPORT

                IMPORT  GETBRIDGEADDRESS

theDialogID     EQU     5000

StackFrame      RECORD  {A6Link},DECR
Result          DS.W    1
ParamBegin      EQU     *
default         DS.W    1
theLocation     DS.L    1
theLocNBPType   DS.L    1
ParamSize       EQU     ParamBegin-*
RetAddr         DS.L    1
A6Link          DS.L    1
itemHit         DS.W    1
savePort        DS.L    1
theString       DS.B    34
LocalSize       EQU     *
                ENDR

                WITH    Globals,StackFrame,EntityName

                LINK    A6,#LocalSize
                MOVEM.L D3-D7/A2-A4,-(SP)

                MOVE    #paramErr,(Result,A6)

                TST.L   (theLocation,A6)
                BEQ     Exit
                MOVE.L  (theLocNBPType,A6),D0
                BEQ     Exit
                MOVE.L  D0,A0
                TST.B   (A0)
                BEQ     Exit
                SUBQ.L  #2,SP
                MOVE.L  A0,-(SP)
                BSR     Wildcard
                TST.B   (SP)+
                BNE     Exit

                MOVE    #watchCursor,-(SP)
                BSR     SetCursor

                MOVE    #resNotFound,(Result,A6)

                MOVE    #theDialogID,-(SP)
                BSR     CenterDialog

                SUBQ.L  #4,SP
                MOVE    #theDialogID,-(SP)
                MOVE.L  #NIL,-(SP)
                PEA     (-1)
                _GetNewDialog
                MOVE.L  (SP)+,D0
                BEQ     Exit
                MOVE.L  D0,A3

                PEA     (savePort,A6)
                _GetPort
                MOVE.L  A3,-(SP)
                _SetPort

                MOVE.L  #GlobalSize,D0
                _NewPtrClear
                MOVE    D0,(Result,A6)
                BNE     Error0
                MOVE.L  A0,A4

                MOVE.L  A3,-(SP)
                MOVE.L  A4,-(SP)
                _SetWRefCon

                MOVE.L  A3,(myDialog,A4)

                PEA     (keyNav,A4)
                BSR     KNInit

                ST      (autoSelect,A4)
                MOVE.B  (default,A6),(hasDefault,A4)
                MOVE.L  (theLocation,A6),(nbpLocation,A4)

                MOVE.L  (theLocNBPType,A6),A0
                LEA     (locNBPType,A4),A1
                MOVEQ   #0,D0
                MOVE.B  (A0),D0
@0              MOVE.B  (A0)+,(A1)+
                DBRA    D0,@0

                MOVE    #memFullErr,(Result,A6)

                SUBQ.L  #4,SP
                MOVE.L  A3,-(SP)
                MOVE    #6,-(SP)
                MOVE    #1,-(SP)
                BSR     NewList
                MOVE.L  (SP)+,(zoneList,A4)
                BEQ     Error1

                SUBQ.L  #4,SP
                MOVE.L  A3,-(SP)
                MOVE    #7,-(SP)
                MOVE    #2,-(SP)
                BSR     NewList
                MOVE.L  (SP)+,(nodeList,A4)
                BEQ     Error2

                SUBQ.L  #2,SP
                JSR     GetBridgeAddress
                TST     (SP)+
                SNE     (hasBridge,A4)

                PEA     (myZoneName,A4)
                BSR     NGetMyZone

                MOVE.L  (zoneList,A4),-(SP)
                BSR     NGetZoneList

                TST.B   (hasDefault,A4)
                BEQ.S   @2

                MOVE.L  (nbpLocation,A4),A0
                LEA     (zoneStr,A0),A0
                CMP.B   #1,(A0)
                BNE.S   @1
                CMP.B   #'*',(1,A0)
                BNE.S   @1
                LEA     (myZoneName,A4),A0

@1              SUBQ.L  #2,SP
                MOVE.L  A0,-(SP)
                MOVE.L  (zoneList,A4),-(SP)
                BSR     SelectCell
                TST.B   (SP)+
                BNE.S   @3

                SF      (autoSelect,A4)

@2              SUBQ.L  #2,SP
                PEA     (myZoneName,A4)
                MOVE.L  (zoneList,A4),-(SP)
                BSR     SelectCell
                ADDQ.L  #2,SP

@3              SUBQ.L  #2,SP
                PEA     (theString,A6)
                MOVE.L  (zoneList,A4),-(SP)
                BSR     GetSelCell
                TST.B   (SP)+
                BEQ.S   @4

                PEA     (theString,A6)
                MOVE.L  A4,-(SP)
                BSR     NBPOpen

@4              MOVE.L  A3,-(SP)
                MOVE    #3,-(SP)
                PEA     TextItem
                BSR     SetIHook

                MOVE.L  A3,-(SP)
                MOVE    #4,-(SP)
                PEA     TextItem
                BSR     SetIHook

                MOVE.L  A3,-(SP)
                MOVE    #5,-(SP)
                PEA     TextItem
                BSR     SetIHook

                MOVE.L  A3,-(SP)
                MOVE    #6,-(SP)
                PEA     ListItem
                BSR     SetIHook

                MOVE.L  A3,-(SP)
                MOVE    #7,-(SP)
                PEA     ListItem
                BSR     SetIHook

                MOVE.L  A3,-(SP)
                MOVE    #8,-(SP)
                PEA     OutlineItem
                BSR     SetIHook

                MOVE    #7,(selectedList,A4)

                MOVE.L  A3,-(SP)
                MOVE    #255,-(SP)
                BSR     HiliteOK

                MOVE.L  A3,-(SP)
                _ShowWindow

                MOVE    #arrowCursor,-(SP)
                BSR     SetCursor

Loop            PEA     MyFilter
                PEA     (itemHit,A6)
                _ModalDialog
                MOVE    (itemHit,A6),D0

                CMP     #1,D0
                BNE.S   @0

                MOVE.L  (theLocation,A6),-(SP)
                MOVE.L  A4,-(SP)
                BSR     GetLocation

                MOVE    #noErr,(Result,A6)
                BRA.S   @1

@0              CMP     #2,D0
                BNE.S   Loop

                MOVE    #userCanceledErr,(Result,A6)

@1              MOVE.L  A3,-(SP)
                _HideWindow

                MOVE.L  A4,-(SP)
                BSR     NBPClose

                MOVE.L  (nodeList,A4),-(SP)
                _LDispose

Error2          MOVE.L  (zoneList,A4),-(SP)
                _LDispose

Error1          MOVE.L  A4,A0
                _DisposePtr

Error0          MOVE.L  (savePort,A6),-(SP)
                _SetPort

                MOVE.L  A3,-(SP)
                _DisposeDialog

Exit            MOVEM.L (SP)+,D3-D7/A2-A4
                UNLK    A6
                MOVE.L  (SP)+,A0
                ADD     #ParamSize,SP
                JMP     (A0)

                ENDF
;———————————————————————————————————————————————————————————————
                END
