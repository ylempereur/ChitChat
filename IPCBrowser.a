                MOVE    #255,-(SP)
                BSR     HiliteOK

                MOVE.L  A4,-(SP)
                BSR     NBPClose

                SUBQ.L  #2,SP
                PEA     (theString,A6)
                MOVE.L  (zoneList,A4),-(SP)
